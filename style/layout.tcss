Screen {
    layout: vertical;
}

Header {
    height: auto;
    dock: top;
    color: $success;
}

#main {
    height: 1fr;
}

#jobs {
    width: 25%;
    height: 1fr;
    border: solid green;
}

#preview {
    width: 1fr;
    height: 1fr;
    border: solid $primary;
}

JobListItem {
    height: 3;
    padding: 0 1;
}
