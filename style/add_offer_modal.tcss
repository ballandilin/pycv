AddOfferScreen {
    align: center middle;
}

#dialog {
    grid-size: 2;
    grid-gutter: 1 2;
    grid-rows: 1 3 3 3 3 3;
    padding: 1 2;
    width: 60;
    height: auto;
    border: thick $background 80%;
    background: $surface;
}

#question,
#dialog Input {
    column-span: 2;
}

#question {
    content-align: center middle;
}

Button {
    width: 100%;
}
